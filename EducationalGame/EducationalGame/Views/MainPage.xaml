<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EducationalGame.MainPage">

    <VerticalStackLayout x:Name="mainlayout">
        

        <HorizontalStackLayout x:Name="languagelayout">
            
            <Button x:Name="EnglishBtn" Text="English"/>

            <Button x:Name="RussianBtn" Text="Russian"/>

            <Button x:Name="EstonianBtn" Text="Estonian"/>

        </HorizontalStackLayout>
        
        

        <HorizontalStackLayout x:Name="gamelayout">

            <CollectionView ItemsSource ="{Binding GameItem}">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout x:Name="itemlayout" WidthRequest="120" HorizontalOptions="Center">

                            <Image x:Name="image" Source="{Binding ImagePath}" 
                           HeightRequest="100" 
                           WidthRequest="100" />

                            <Label x:Name="label" Text="{Binding DisplayName}" 
                           HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
            
        </HorizontalStackLayout>
        
        
        

        <HorizontalStackLayout x:Name="imagelayout">
            
            <Image x:Name="dragimage1" Source="cat.jpg" WidthRequest="80" HeightRequest="80">

                <Image.GestureRecognizers>
                    <DragGestureRecognizer DragStartingCommand="{Binding DragStartingCommand}" 
                                   DragStartingCommandParameter="DragImage1" />
                </Image.GestureRecognizers>
                
            </Image>

            <Image x:Name="dragimage2" Source="dog.jpg" WidthRequest="80" HeightRequest="80">

                <Image.GestureRecognizers>
                    <DragGestureRecognizer DragStartingCommand="{Binding DragStartingCommand}" 
                       DragStartingCommandParameter="DragImage2" />
                </Image.GestureRecognizers>

            </Image>

            <Image x:Name="dragimage3" Source="hamster.png" WidthRequest="80" HeightRequest="80">

                <Image.GestureRecognizers>
                    <DragGestureRecognizer DragStartingCommand="{Binding DragStartingCommand}" 
           DragStartingCommandParameter="DragImage3" />
                </Image.GestureRecognizers>

            </Image>
        </HorizontalStackLayout>

        <HorizontalStackLayout x:Name="buttonlayout">
            <Button x:Name="StatisticsBtn" Text="Statistics"/>
            <Button x:Name="StartBtn" Text="Start"/>
            <Button x:Name="ThemeBtn" Text="Theme"/>
        </HorizontalStackLayout>
        
        
        
    </VerticalStackLayout>

    

</ContentPage>
