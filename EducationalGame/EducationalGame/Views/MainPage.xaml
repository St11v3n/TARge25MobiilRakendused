<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:EducationalGame.ViewModels"
             x:Class="EducationalGame.MainPage">

    <VerticalStackLayout x:Name="mainlayout" HorizontalOptions="Center">
        

        <HorizontalStackLayout x:Name="languagelayout" Spacing="20">

            <Button x:Name="EnglishBtn" Text="{Binding EnglishText}" Command="{Binding EnglishBtnCommand}"/>

            <Button x:Name="RussianBtn" Text="{Binding RussianText}" Command="{Binding RussianBtnCommand}"/>

            <Button x:Name="EstonianBtn" Text="{Binding EstonianText}" Command="{Binding EstonianBtnCommand}"/>

        </HorizontalStackLayout>
        
        

        <HorizontalStackLayout x:Name="gamelayout" Spacing="20" Margin="20">

            <CollectionView ItemsSource ="{Binding GameItem}">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout WidthRequest="120" HorizontalOptions="Center">

                            
                            <VerticalStackLayout.GestureRecognizers>
                                <DropGestureRecognizer DropCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=DropCommand}"
                               DropCommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>

                            <Image Source="{Binding ImagePath}" HeightRequest="100" WidthRequest="100" />
                            <Label Text="{Binding AnimalName}" HorizontalTextAlignment="Center" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
            
        </HorizontalStackLayout>
        
        
        

        <HorizontalStackLayout x:Name="imagelayout" Margin="40" Spacing="20">
            
            <Image x:Name="dragimage1" Source="cat.jpg" WidthRequest="80" HeightRequest="80">

                <Image.GestureRecognizers>
                    <DragGestureRecognizer DragStartingCommand="{Binding DragStartingCommand}" 
                                   DragStartingCommandParameter="DragImage1" />
                </Image.GestureRecognizers>
                
            </Image>

            <Image x:Name="dragimage2" Source="dog.jpg" WidthRequest="80" HeightRequest="80">

                <Image.GestureRecognizers>
                    <DragGestureRecognizer DragStartingCommand="{Binding DragStartingCommand}" 
                       DragStartingCommandParameter="DragImage2" />
                </Image.GestureRecognizers>

            </Image>

            <Image x:Name="dragimage3" Source="hamster.png" WidthRequest="80" HeightRequest="80">

                <Image.GestureRecognizers>
                    <DragGestureRecognizer DragStartingCommand="{Binding DragStartingCommand}" 
           DragStartingCommandParameter="DragImage3" />
                </Image.GestureRecognizers>

            </Image>
        </HorizontalStackLayout>

        <HorizontalStackLayout x:Name="buttonlayout" Spacing="20" Margin="40">
            <Button x:Name="StatisticsBtn" Text="{Binding StatisticsText}" Command="{Binding StatisticsBtnCommand}"/>
            <Button x:Name="StartBtn" Text="{Binding StartText}" Command="{Binding StartBtnCommand}"/>
            <Button x:Name="ThemeBtn" Text="{Binding ThemeText}" Command="{Binding ThemeBtnCommand}"/>
        </HorizontalStackLayout>
        
        
        
    </VerticalStackLayout>

    

</ContentPage>
